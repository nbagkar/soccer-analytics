# Copy to .env and fill in. Never commit .env.

# Required for fixtures, results and standings. Free registration:
# https://www.football-data.org/client/register
# Without it, football-data.org is silently disabled rather than failing at request time.
SOCCER_FOOTBALL_DATA_ORG_TOKEN=

# TheSportsDB's documented free key. Not a secret -- override only if you have a
# supporter key. This is currently the sole free live-score source.
SOCCER_THESPORTSDB_KEY=123

SOCCER_DATA_DIR=data
SOCCER_LOG_LEVEL=INFO

# --- Optional sources, off by default ---------------------------------------

# German football. Post-match only (~1.5h lag), not live. Licence is claimed ODbL
# but unconfirmed -- if it applies, share-alike binds anything you derive.
SOCCER_ENABLE_OPENLIGADB=false

# Free Opta xG, Premier League only. Premier League terms bar "creating a database";
# enabling this is a decision you are making knowingly. Never redistribute.
SOCCER_ENABLE_FPL=false
