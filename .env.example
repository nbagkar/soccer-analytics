# Copy to .env and fill in. Never commit .env.

# Required for fixtures, results and standings. Free registration:
# https://www.football-data.org/client/register
# Without it, football-data.org is silently disabled rather than failing at request time.
SOCCER_FOOTBALL_DATA_ORG_TOKEN=

# TheSportsDB's documented free key. Not a secret -- override only if you have a
# supporter key. This is currently the sole free live-score source.
SOCCER_THESPORTSDB_KEY=123

# API-Football (api-sports.io). Optional, off when blank. Register at
# https://dashboard.api-football.com/register -- the free plan is 100 requests/day.
# Run `soccer probe-api-football` to see what your key actually covers before paying.
SOCCER_API_FOOTBALL_KEY=
# Match these to your plan (free: 100/day, 10/min). Reserve = requests/day held back
# from automated jobs so a manual check is always possible.
SOCCER_API_FOOTBALL_DAILY_LIMIT=100
SOCCER_API_FOOTBALL_RPM=10
SOCCER_API_FOOTBALL_RESERVE=5

# Optional LLM narrator for the assistant. Off unless provider, model and key are all set.
# The app still computes every answer locally; when on, the question and that computed
# answer are sent to the provider to be rewritten, and a rewrite that mentions a number the
# computed answer doesn't contain is thrown away. Providers: openai, deepseek, gemini (all via
# their OpenAI-compatible chat endpoint), or any other with SOCCER_LLM_BASE_URL.
# Pick the model from the provider's current model list. Also set a spending limit on the
# provider's own dashboard -- that's the only cap they enforce.
SOCCER_LLM_PROVIDER=
SOCCER_LLM_MODEL=
SOCCER_LLM_API_KEY=
# Local monthly cap on tokens (input + output); calls stop once it's spent.
SOCCER_LLM_MONTHLY_TOKEN_CAP=2000000
# USD per million tokens from the provider's pricing page, for the cost estimate shown.
SOCCER_LLM_PRICE_IN_PER_M=
SOCCER_LLM_PRICE_OUT_PER_M=

SOCCER_DATA_DIR=data
SOCCER_LOG_LEVEL=INFO

# --- Optional sources, off by default ---------------------------------------

# Free Opta xG, Premier League only. Premier League terms bar "creating a database";
# enabling this is a decision you are making knowingly. Never redistribute.
SOCCER_ENABLE_FPL=false

# --- Usage tracking ---------------------------------------------------------

# Local-only log of which pages/actions/assistant intents get used (see `soccer usage`).
SOCCER_USAGE_TRACKING=true

# Refresh results (and fixtures, if stale) in the background when the dashboard opens on
# data more than a day old. Needs network; false keeps refreshing manual.
SOCCER_AUTO_REFRESH=true
