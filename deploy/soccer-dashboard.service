[Unit]
Description=Soccer analytics dashboard (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__/src/soccer/dashboard
EnvironmentFile=__APP_DIR__/.env
Environment=SOCCER_DATA_DIR=__APP_DIR__/data
ExecStart=__APP_DIR__/.venv/bin/streamlit run app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
